{
  "name": "housekeep",
  "version": "0.1.0",
  "description": "See whether your git work is safe: committed, pushed, in sync with main, and cleaned up. A terminal report and a live visual map.",
  "keywords": [
    "git",
    "worktree",
    "branches",
    "cleanup",
    "doctor",
    "vibe coding"
  ],
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "housekeep": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && node --test --test-concurrency=4 dist/test/housekeep.test.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "7.0.2"
  }
}
